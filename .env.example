# Copy to .env (never commit .env). On Vercel, set these under Project → Settings → Environment Variables.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Optional: comma-separated model preference list (first one that works is used)
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# Optional: require this code in the app's Settings before the site's key is used
# ACCESS_CODE=
